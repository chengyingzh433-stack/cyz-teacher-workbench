{
  "name": "cyz-teacher-workbench",
  "version": "1.2.0",
  "private": true,
  "description": "cyz的教师工作台：互动教室、排座、学生档案、成绩分析与 AI 助手",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write \"src/**/*.{js,css,json}\" \"scripts/*.mjs\" \"tests/*.mjs\" package.json index.html",
    "format:check": "prettier --check \"src/**/*.{js,css,json}\" \"scripts/*.mjs\" \"tests/*.mjs\" package.json index.html"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "eslint-scope": "^9.1.2",
    "prettier": "^3.9.10"
  },
  "author": "cyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/chengyingzh433-stack/cyz-teacher-workbench.git"
  }
}
