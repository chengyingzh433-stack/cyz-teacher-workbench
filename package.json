{
  "name": "cyz-teacher-workbench-web",
  "version": "0.5.2-physics-mean",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit && node scripts/check-boundaries.mjs",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run check && node scripts/build.mjs && npm run check:artifact",
    "check:artifact": "node scripts/check-artifact.mjs",
    "dev": "node scripts/dev.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/*.{ts,tsx}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/*.{ts,tsx}\" \"scripts/*.mjs\""
  },
  "dependencies": {
    "dexie": "4.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uuid": "14.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
